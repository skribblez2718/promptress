{
  "name": "@promptress/word-generator",
  "version": "1.0.0",
  "private": true,
  "description": "Harness-neutral TypeScript functions for generating validated Word documents from Markdown",
  "type": "module",
  "main": "index.ts",
  "exports": {
    ".": "./index.ts"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "format:check": "prettier --check \"**/*.{ts,json,md}\"",
    "test:all": "npm run typecheck && npm run test && npm run format:check"
  },
  "dependencies": {
    "docx": "9.5.1",
    "fast-xml-parser": "5.3.0",
    "image-size": "2.0.2",
    "jszip": "3.10.1",
    "markdown-it": "14.1.0"
  },
  "devDependencies": {
    "@types/markdown-it": "^14.2.0",
    "@types/node": "^25.6.0",
    "prettier": "3.9.8",
    "typescript": "^6.0.3",
    "vitest": "^4.1.7"
  }
}
